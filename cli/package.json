{
  "name": "spacehub",
  "version": "0.1.0",
  "private": true,
  "description": "spacehub client: a gh-style CLI plus the git remote helper (git clone/push/fetch spacehub://owner/space)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spacehub": "bin/spacehub",
    "git-remote-spacehub": "bin/git-remote-spacehub"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts src/remote.ts --bundle --platform=node --format=esm --target=node22 --out-extension:.js=.mjs --outdir=dist --log-level=warning",
    "typecheck": "tsc --noEmit -p .",
    "generate": "spacetime generate --yes --lang typescript --out-dir src/module_bindings --module-path ../module"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "spacetimedb": "2.12.*",
    "typescript": "~5.6.2"
  }
}
