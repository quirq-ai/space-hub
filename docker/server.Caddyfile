# Built into the server image. SpacetimeDB listens only inside the container;
# this is the one public port.
#
# PRIVATE HUB (branch privatehub): every request is checked first. Caddy asks
# the web service's gate (cli/src/gate.ts, GET /-/gate) with forward_auth and
# forwards only what it lets through: a request carrying the hub token of
# someone signed in with XO (Clerk), or of one of their agents. The only
# things reachable without one are:
#   - /healthz (the platform's probe);
#   - GET /-/login, the sign-in page, which offers only Sign in with XO;
#   - /-/login/xo and its callback, the XO (Clerk) sign-in itself;
#   - /-/api/xo/v1/*, xo.quirq.dev's API, which needs SPACEHUB_XO_KEY;
#   - the app's static files under /-/app/ (CSS, scripts, icons: no data).
#
# Behind the gate it serves:
#   - the two endpoints clients need: one swaps an identity token for a
#     short-lived websocket token, the other is the database websocket;
#   - /-/* and /gh/* : the web service (projects, live pages, repo rooms),
#     except the hub's own pages /-/guide and /-/builders;
#   - everything else as the web UI, which the module renders (original
#     request URI passed in X-Spacehub-Uri).
# Publishing modules, SQL, logs and deletes stay unreachable.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# The platform's ingress terminates TLS; trust its X-Forwarded-Proto.
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	# The gate (cli/src/gate.ts). forward_auth runs before every handle below.
	@gated {
		not path /healthz /-/login/xo /-/login/xo/callback /-/api/xo/v1/*
		not {
			method GET HEAD
			path /-/login
		}
		not {
			method GET HEAD
			path_regexp ^/-/app/[A-Za-z0-9_.-]+\.(?:css|js|svg|png|ico|woff2?)$
		}
	}
	forward_auth @gated 127.0.0.1:{$SPACEHUB_WEB_PORT:3002} {
		uri /-/gate
	}
	# The gate itself is only for the proxy.
	handle /-/gate {
		respond 404
	}
	@client path /v1/identity/websocket-token /v1/database/{$SPACEHUB_DB:spacehub}/subscribe
	handle @client {
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001}
	}
	handle /healthz {
		rewrite * /v1/ping
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001}
	}
	@hubpages path /-/guide /-/guide/* /-/builders /-/builders/*
	handle @hubpages {
		rewrite * /v1/database/{$SPACEHUB_DB:spacehub}/route/ui
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001} {
			header_up X-Spacehub-Uri {http.request.orig_uri}
		}
	}
	handle /-/* {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	# Repo rooms (cli/src/rooms.ts): /gh/<owner>/<repo> opens a public GitHub
	# repository's explainer and group chat.
	handle /gh/* {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	# The hub's app (web service, cli/src/app.ts): the hub, a space, a project.
	# Deeper paths (tree, blob, raw, commits, commit, refs, activity), the
	# /guide and /builders redirects, and ?view=code (the app's Code tab: the
	# module's own hub, space and project pages) stay with the module below.
	@app {
		method GET HEAD
		path_regexp ^/(?:[a-z0-9][a-z0-9-]*(?:/[A-Za-z0-9_.-]+)?)?/?$
		not path /guide /builders /healthz
		not query view=code
	}
	handle @app {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	handle {
		rewrite * /v1/database/{$SPACEHUB_DB:spacehub}/route/ui
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001} {
			header_up X-Spacehub-Uri {http.request.orig_uri}
		}
	}
}
