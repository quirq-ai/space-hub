# Built into the server image. SpacetimeDB listens only inside the container;
# this is the one public port. It serves:
#   - the two endpoints clients need: one swaps an identity token for a
#     short-lived websocket token, the other is the database websocket;
#   - /healthz;
#   - /-/* and /gh/* : the web service (sign in, sign up, create and import
#     projects, live pages, repo rooms), except the hub's own pages /-/guide and /-/builders;
#   - everything else as the web UI, which the module renders: through the web
#     service (GET /-/ui, the original request URI in X-Spacehub-Uri), which
#     checks who is signed in and asks the module as that viewer, so a private
#     project is shown only to those who may read it (cli/src/modulepage.ts).
#     The module's routes are never reached from here directly.
# On a members-only hub all but /healthz, the two client endpoints and the
# sign-in pages is for members only (forward_auth below).
# Publishing modules, SQL, logs and deletes stay unreachable.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# The platform's ingress terminates TLS; trust its X-Forwarded-Proto.
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	# Members-only (cli/src/frontdoor.ts): every request but /healthz and the
	# database's two client endpoints (its views already give a stranger
	# nothing) first asks the web service. A 2xx lets it through; otherwise
	# its answer (sign in, or a 401) is the response. With members-only off,
	# and for the sign-in pages, it always says yes. Caddy sets the
	# X-Forwarded-Method and X-Forwarded-Uri it sends there itself.
	@door not path /healthz /v1/identity/websocket-token /v1/database/{$SPACEHUB_DB:spacehub}/subscribe
	forward_auth @door 127.0.0.1:{$SPACEHUB_WEB_PORT:3002} {
		uri /-/auth/check
	}
	# Headers only this proxy sets: never as a client sent them.
	request_header -X-Forwarded-Method
	request_header -X-Forwarded-Uri
	request_header -X-Spacehub-Uri
	# Who the web service vouches for, with its secret (cli/src/modulepage.ts).
	request_header -X-Spacehub-Viewer
	request_header -X-Spacehub-Secret
	@client path /v1/identity/websocket-token /v1/database/{$SPACEHUB_DB:spacehub}/subscribe
	handle @client {
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001}
	}
	handle /healthz {
		rewrite * /v1/ping
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001}
	}
	@hubpages path /-/guide /-/guide/* /-/builders /-/builders/*
	handle @hubpages {
		rewrite * /-/ui
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002} {
			header_up X-Spacehub-Uri {http.request.orig_uri}
		}
	}
	handle /-/* {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	# Repo rooms (cli/src/rooms.ts): /gh/<owner>/<repo> opens a public GitHub
	# repository's explainer and group chat.
	handle /gh/* {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	# The hub's app (web service, cli/src/app.ts): the hub, a space, a project.
	# Deeper paths (tree, blob, raw, commits, commit, refs, activity), the
	# /guide and /builders redirects, and ?view=code (the app's Code tab: the
	# module's own hub, space and project pages) stay with the module below.
	@app {
		method GET HEAD
		path_regexp ^/(?:[a-z0-9][a-z0-9-]*(?:/[A-Za-z0-9_.-]+)?)?/?$
		not path /guide /builders /healthz
		not query view=code
	}
	handle @app {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	# The module's pages, as the signed-in viewer (cli/src/modulepage.ts).
	handle {
		rewrite * /-/ui
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002} {
			header_up X-Spacehub-Uri {http.request.orig_uri}
		}
	}
}
