# Built into the server image. SpacetimeDB listens only inside the container;
# this is the one public port. It serves:
#   - the two endpoints clients need: one swaps an identity token for a
#     short-lived websocket token, the other is the database websocket;
#   - /healthz;
#   - /-/* : the web service (sign in, sign up, create and import projects,
#     live pages), except the hub's own pages /-/guide and /-/builders;
#   - everything else as the web UI, which the module renders (original
#     request URI passed in X-Spacehub-Uri).
# Publishing modules, SQL, logs and deletes stay unreachable.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# The platform's ingress terminates TLS; trust its X-Forwarded-Proto.
		trusted_proxies static private_ranges
	}
}

:{$PORT:3000} {
	@client path /v1/identity/websocket-token /v1/database/{$SPACEHUB_DB:spacehub}/subscribe
	handle @client {
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001}
	}
	handle /healthz {
		rewrite * /v1/ping
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001}
	}
	@hubpages path /-/guide /-/guide/* /-/builders /-/builders/*
	handle @hubpages {
		rewrite * /v1/database/{$SPACEHUB_DB:spacehub}/route/ui
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001} {
			header_up X-Spacehub-Uri {http.request.orig_uri}
		}
	}
	handle /-/* {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	# The hub's app (web service, cli/src/app.ts): the hub, a space, a project.
	# Deeper paths (tree, blob, raw, commits, commit, refs, activity), the
	# /guide and /builders redirects, and ?view=code (the app's Code tab: the
	# module's own hub, space and project pages) stay with the module below.
	@app {
		method GET HEAD
		path_regexp ^/(?:[a-z0-9][a-z0-9-]*(?:/[A-Za-z0-9_.-]+)?)?/?$
		not path /guide /builders /healthz
		not query view=code
	}
	handle @app {
		reverse_proxy 127.0.0.1:{$SPACEHUB_WEB_PORT:3002}
	}
	handle {
		rewrite * /v1/database/{$SPACEHUB_DB:spacehub}/route/ui
		reverse_proxy 127.0.0.1:{$SPACETIME_INTERNAL_PORT:3001} {
			header_up X-Spacehub-Uri {http.request.orig_uri}
		}
	}
}
